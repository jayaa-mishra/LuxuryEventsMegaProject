NODE_ENV=development
PORT=5001
# Shares the same Mongo + JWT secret as the main API so access tokens interoperate
MONGO_URI=mongodb://localhost:27017/luxury_events
JWT_SECRET=replace_me_with_a_long_random_secret
# Short-lived access token; the frontend silently refreshes it
JWT_ACCESS_EXPIRES_IN=15m
# Separate refresh secret (falls back to a derived value if blank)
JWT_REFRESH_SECRET=replace_me_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_EXPIRES_DAYS=7
CLIENT_URL=http://localhost:5173
