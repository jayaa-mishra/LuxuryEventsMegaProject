# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Rename this file to .env and fill in the values below.
# Do NOT commit the actual .env file to version control.

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
VITE_API_BASE_URL=http://localhost:5000/api
# The base URL where the backend API is hosted. Use /api for relative paths in Docker.

# ==========================================
# BACKEND CORE CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MONGO_URI=mongodb://localhost:27017/luxury_events
# Provide the connection string for MongoDB (Local or Atlas)

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# ==========================================
# CLOUDINARY (Images & PDFs)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# RAZORPAY (Payments)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ==========================================
# SMTP / EMAIL NOTIFICATIONS (Nodemailer)
# ==========================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# ==========================================
# COMPANY DETAILS (For PDF Generation)
# ==========================================
COMPANY_NAME="Luxury Events"
COMPANY_EMAIL="contact@luxuryevents.com"
COMPANY_PHONE="+1-800-LUXURY"
COMPANY_ADDRESS="123 Elite Avenue, Beverly Hills, CA 90210"
COMPANY_LOGO_URL="https://example.com/logo.png"
