# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# Rename this file to .env and fill in the values below.
# Do NOT commit the actual .env file to version control.

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
VITE_API_BASE_URL=/api/v1
# Relative, same-origin base. A proxy forwards /api to the gateway (:8080):
# Vite dev server in development (see vite.config.ts) and nginx in Docker
# (see nginx.conf). Staying same-origin keeps the httpOnly refresh cookie working.
# Set VITE_GATEWAY_URL to point the dev proxy at a non-default gateway address.
# To bypass the gateway and hit the main API directly, set
# VITE_API_BASE_URL=http://localhost:5000/api/v1 (refresh-token flow won't apply).

# ==========================================
# BACKEND CORE CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MONGO_URI=mongodb://localhost:27017/luxury_events
# Provide the connection string for MongoDB (Local or Atlas)

# ==========================================
# AUTHENTICATION (JWT)
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=7d

# ==========================================
# REDIS (Cache + BullMQ notification queue)
# ==========================================
# In Docker use the service name "redis"; locally use 127.0.0.1.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternatively provide a full URL (takes precedence over host/port):
# REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=300

# ==========================================
# MICROSERVICE ENDPOINTS (used by the gateway)
# ==========================================
MAIN_API_URL=http://localhost:5000
AUTH_SERVICE_URL=http://localhost:5001
NOTIFICATION_SERVICE_URL=http://localhost:5002
GATEWAY_PORT=8080

# ==========================================
# CLOUDINARY (Images & PDFs)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# RAZORPAY (Payments)
# ==========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret configured in the Razorpay dashboard for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==========================================
# SMTP / EMAIL NOTIFICATIONS (Nodemailer)
# ==========================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# ==========================================
# COMPANY DETAILS (For PDF Generation)
# ==========================================
COMPANY_NAME="Luxury Events"
COMPANY_EMAIL="contact@luxuryevents.com"
COMPANY_PHONE="+1-800-LUXURY"
COMPANY_ADDRESS="123 Elite Avenue, Beverly Hills, CA 90210"
COMPANY_LOGO_URL="https://example.com/logo.png"
